# Copy to .env and fill in. Never commit .env.

# --- Required ---
BOT_TOKEN=
# MTProto user session (generate once with: node generate_mtproto_session.js)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# --- Runtime state ---
# Directory for ledgers, caches and registries (outside the git checkout on servers).
NEXAHUB_DATA_DIR=/var/lib/nexahub
# Telegram user id allowed to run /inspect_videos
ADMIN_USER_ID=

# --- Optional features (all OFF unless set to "true") ---
TELEGRAM_PIPELINE_SCHEDULER_ENABLED=false
EXTERNAL_SOURCE_SCHEDULER_ENABLED=false
VIDEO_PIPELINE_ENABLED=false

# --- Video pipeline (only when VIDEO_PIPELINE_ENABLED=true) ---
# Must be set explicitly: "authorized" (uses VIDEO_PIPELINE_AUTHORIZED_SOURCE_URL) or "fixture" (test data only).
VIDEO_PIPELINE_SOURCE_MODE=
VIDEO_PIPELINE_AUTHORIZED_SOURCE_URL=
VIDEO_PIPELINE_STAGING_CHAT_ID=
VIDEO_PIPELINE_WORKERS=1
# Python interpreter with playwright installed (e.g. a venv's bin/python)
PYTHON_PATH=python3
# Telegram Bot API upload limit (bytes); larger files are skipped, not retried
VIDEO_PIPELINE_MAX_UPLOAD_BYTES=52428800
# Disk hygiene for downloaded media
VIDEO_PIPELINE_DOWNLOAD_RETENTION_HOURS=48
VIDEO_PIPELINE_DOWNLOAD_MAX_BYTES=10737418240
VIDEO_PIPELINE_MAX_PUBLISH_ATTEMPTS=3
# ffprobe / full-decode validation timeouts (ms)
VIDEO_PIPELINE_PROBE_TIMEOUT_MS=60000
VIDEO_PIPELINE_VALIDATION_TIMEOUT_MS=300000

# --- Logging ---
LOG_LEVEL=info
DEBUG=false

# Do NOT set these on a plain server (they were Nixpacks/Railway-only):
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH, CHROME_BIN, PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS
